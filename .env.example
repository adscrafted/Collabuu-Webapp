# ===================================
# COLLABUU WEB APPLICATION
# Environment Variables Configuration
# ===================================

# ----------------------------------
# Backend API Configuration
# ----------------------------------
# The base URL for the backend API
# NOTE: In development, the API client auto-detects the port using window.location.origin
#       so the port number doesn't need to match your Next.js dev server port
# Development: http://localhost:3000 (or any port - it auto-detects)
# Production: https://your-production-api.com
NEXT_PUBLIC_API_URL=https://collabuu-production.up.railway.app

# The base URL for this Next.js application
# Used for Stripe checkout redirects and email links
# Development: http://localhost:3000 (or whatever port Next.js chooses)
# Production: https://your-app-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------
# Supabase Configuration
# ----------------------------------
# Get these from: https://supabase.com → Project Settings → API
# IMPORTANT: These are PUBLIC keys and can be safely exposed in the client

# Your Supabase project URL
# Format: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous/Public key (safe to expose)
# Starts with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (PRIVATE - server-side only!)
# Only use in API routes or server components - NEVER expose to client
# Get from: Supabase Project Settings → API → service_role key
# ⚠️ CRITICAL: This key bypasses Row Level Security - protect it carefully!
# Used for: Admin authentication, privileged database operations, audit logging
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----------------------------------
# Email Configuration (Resend)
# ----------------------------------
# Email service integration for transactional emails (withdrawal notifications, etc.)
# Get your API key from: https://resend.com/api-keys
# Documentation: https://resend.com/docs/introduction

# Resend API Key (PRIVATE - server-side only!)
# Get from: Resend Dashboard → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# From email address (must be verified in Resend)
# For development, you can use: onboarding@resend.dev (no verification needed)
# For production, add and verify your domain in Resend Dashboard
EMAIL_FROM=noreply@collabuu.com

# Support email address (displayed in email footers and contact links)
SUPPORT_EMAIL=support@collabuu.com

# ----------------------------------
# Stripe Payment Configuration
# ----------------------------------
# Get these from: https://dashboard.stripe.com → Developers → API Keys
# The app automatically detects test/live mode based on the publishable key prefix

# --- TEST MODE (for development) ---
# Use these for local testing with test cards (4242 4242 4242 4242)
# Get keys from: Stripe Dashboard → Toggle "Test Mode" → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# For local webhook testing, run: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Copy the webhook secret (whsec_...) from the CLI output
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- LIVE MODE (for production) ---
# ⚠️ Switch to these when deploying to production
# Get keys from: Stripe Dashboard → Toggle "Test Mode" OFF → Developers → API Keys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
# STRIPE_SECRET_KEY=sk_live_your_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# ----------------------------------
# Optional: Error Tracking (NOT YET IMPLEMENTED)
# ----------------------------------
# FUTURE: Sentry error tracking integration
# Get DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ----------------------------------
# Optional: Development Settings
# ----------------------------------
# Node environment (automatically set by Next.js)
# Values: development, production, test
# NODE_ENV=development

# Custom port for development server (default: 3000)
# PORT=3000

# ----------------------------------
# Notes:
# ----------------------------------
# 1. Copy this file to .env.local and fill in your actual values
# 2. Never commit .env.local to version control
# 3. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 4. Variables without NEXT_PUBLIC_ are server-side only
# 5. Restart dev server after changing environment variables
# 6. For production deployment, set these in Vercel Dashboard
